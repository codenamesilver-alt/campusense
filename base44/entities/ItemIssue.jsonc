{
  "name": "ItemIssue",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Reference to InventoryItem"
    },
    "issued_to_id": {
      "type": "string",
      "description": "Staff or Student ID"
    },
    "issued_to_type": {
      "type": "string",
      "enum": [
        "staff",
        "student"
      ]
    },
    "issued_to_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expected_return_date": {
      "type": "string",
      "format": "date"
    },
    "actual_return_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "returned",
        "overdue"
      ],
      "default": "issued"
    },
    "remarks": {
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "issued_to_id",
    "issued_to_type",
    "issued_to_name",
    "quantity",
    "issue_date",
    "expected_return_date"
  ]
}