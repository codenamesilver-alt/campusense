{
  "name": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the book"
    },
    "author": {
      "type": "string",
      "description": "Author name"
    },
    "isbn": {
      "type": "string",
      "description": "ISBN number"
    },
    "publisher": {
      "type": "string",
      "description": "Publisher name"
    },
    "category": {
      "type": "string",
      "description": "Book category/genre"
    },
    "total_copies": {
      "type": "number",
      "description": "Total number of copies"
    },
    "available_copies": {
      "type": "number",
      "description": "Available copies for issue"
    },
    "price": {
      "type": "number",
      "description": "Book price"
    },
    "publication_year": {
      "type": "string",
      "description": "Year of publication"
    },
    "rack_number": {
      "type": "string",
      "description": "Library rack location"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "title",
    "author",
    "total_copies",
    "available_copies"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "role": "librarian"
          }
        ]
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "role": "librarian"
          }
        ]
      }
    },
    "delete": {
      "user_condition": {
        "$or": [
          {
            "role": "admin"
          },
          {
            "role": "librarian"
          }
        ]
      }
    }
  }
}