{
  "name": "SchoolSetting",
  "type": "object",
  "properties": {
    "school_name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "header_image_url": {
      "type": "string",
      "description": "URL for printable document headers"
    },
    "current_session_id": {
      "type": "string",
      "description": "ID of the current academic session from the Session entity"
    },
    "allow_backdated_receipt": {
      "type": "boolean",
      "default": false,
      "description": "Allow backdating receipt dates in fee collection"
    }
  },
  "required": [
    "school_name"
  ]
}