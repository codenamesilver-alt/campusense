{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "vehicle_number": {
      "type": "string",
      "description": "Registration number of the vehicle"
    },
    "model": {
      "type": "string",
      "description": "Make and model of the vehicle"
    },
    "capacity": {
      "type": "number",
      "description": "Seating capacity"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date",
      "description": "Insurance expiry date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "in_maintenance",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "vehicle_number",
    "model",
    "capacity"
  ]
}